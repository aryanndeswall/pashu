# ==============================================================================
# Pashu-Suraksha (पशु सुरक्षा) — Backend Environment Configuration
# ==============================================================================

# Project & API
PROJECT_NAME="Pashu-Suraksha Cloud Surveillance Gateway"
VERSION="1.1.0"
API_PREFIX="/api/v1"
CORS_ORIGINS=["*"]

# Database Connection (PostgreSQL 16 + PostGIS 3.4)
# Default fallback: local async sqlite
# Production example: postgresql+asyncpg://postgres:password@localhost:5432/pashu_db
DATABASE_URL="sqlite+aiosqlite:///./pashu_cloud.db"

# Data Privacy (DPDP Act 2023)
DPDP_PHONE_SALT="pashu_dpdp_secret_salt_2026"

# Google Gemini 3.7 / 2.5 Flash API Key
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
AI_INFERENCE_TIMEOUT_SECONDS=3.0

# Firebase Cloud Storage & Admin SDK
# Path to service account JSON file (e.g., ./firebase-service-account.json)
FIREBASE_CREDENTIALS_PATH=""
FIREBASE_STORAGE_BUCKET=""

# Redis Pub/Sub Live Alert Broker (for live outbreak streaming)
# e.g., redis://localhost:6379/0 or rediss://default:password@xyz.upstash.io:6379
REDIS_URL=""
